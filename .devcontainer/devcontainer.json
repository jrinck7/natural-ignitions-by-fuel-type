{
    "name": "gds-project2",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".",
        "args": {
            "NORTON_TLS_FIX": "false"
        }
    },
    "remoteUser": "jovyan",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/jovyan/work,type=bind",
    "workspaceFolder": "/home/jovyan/work",
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/jovyan/.claude"
    },
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/home/jovyan/.local/bin"
    },
    "postCreateCommand": "command -v claude >/dev/null || curl -fsSL https://claude.ai/install.sh | bash",
    "postStartCommand": "bash /usr/local/bin/before-notebook.d/10-earthdata-netrc.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "anthropic.claude-code"
            ]
        }
    },
    "mounts": [
        "source=claude-config,target=/home/jovyan/.claude,type=volume",
        "source=${localEnv:USERPROFILE}/.netrc,target=/run/secrets/netrc,type=bind,readonly"
    ]
}
