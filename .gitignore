# Machine-specific TLS interception workaround - never commit this
norton-root-ca.crt

# Jupyter
.ipynb_checkpoints/

# Notebooks are jupytext-paired with a .py:percent file, which is what's
# tracked (clean diffs, no embedded outputs/execution counts). Run
# `jupytext --to notebook <name>.py` to regenerate your local .ipynb.
*.ipynb

# Credentials - should never live in this repo
*.netrc
.netrc

__pycache__/
data/
outputs/

# LaTeX build artifacts - regenerated on every compile
pdfs/*.aux
pdfs/*.log
pdfs/*.out

# Secrets and large local files
token.txt
data.zip

# LaTeX build artifacts at the repo root
/*.aux
/*.log
/*.out
pdfs/*.tex
pdfs/Project2.pdf
pdfs/*_files/

# Personal Claude Code settings
.claude/settings.json
.claude/settings.local.json

